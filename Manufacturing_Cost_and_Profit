# program to find Manufacturing Cost and Profit

materials = float(input("Enter material cost: "))
labour = float(input("Enter labour cost: "))
machine_cost = float(input("Enter machine cost: "))
selling_price = float(input("Enter selling price: "))
profit_target = float(input("Enter the required profit: "))

total_cost = materials + labour + machine_cost
profit = selling_price - total_cost

print("Total cost:", total_cost)
print("Profit:", profit)

if profit >= profit_target:
    print("Profit target reached")
else:
    print("Profit target not reached")